diff -ruN a/floating_point/fft/fft80_exact.h b/floating_point/fft/fft80_exact.h
--- a/floating_point/fft/fft80_exact.h	1969-12-31 19:00:00.000000000 -0500
+++ b/floating_point/fft/fft80_exact.h	2026-09-16 19:14:30.727928946 -0400
@@ -0,0 +1,37 @@
+/* Isolated prototype: exact 80-point PFA factorization used by the current
+ * LC3plus generic path, 16 then 5. Include after fft16/fft5 definitions.
+ * No change to any floating arithmetic inside either kernel.
+ * The fused form avoids the generic final 80-complex scratch-to-x copy.
+ */
+static __attribute__((noinline)) void fft80_exact(float *x)
+{
+    float tmp[160];
+    int idx = 0, at = 0;
+    for (int row = 0; row < 5; ++row) {
+        for (int col = 0; col < 15; ++col) {
+            tmp[at++] = x[2 * idx];
+            tmp[at++] = x[2 * idx + 1];
+            idx += 65; /* 5 * inverse(5,16) = 5 * 13 */
+            if (idx > 80) idx -= 80;
+        }
+        tmp[at++] = x[2 * idx];
+        tmp[at++] = x[2 * idx + 1];
+        ++idx;
+    }
+    for (int row = 0; row < 5; ++row) fft16(tmp + 32 * row);
+    for (int col = 0; col < 16; ++col) {
+        float column[10];
+        for (int row = 0; row < 5; ++row) {
+            column[2 * row] = tmp[2 * (16 * row + col)];
+            column[2 * row + 1] = tmp[2 * (16 * row + col) + 1];
+        }
+        fft5(column);
+        idx = col * 5;
+        for (int row = 0; row < 5; ++row) {
+            x[2 * idx] = column[2 * row];
+            x[2 * idx + 1] = column[2 * row + 1];
+            idx += 16;
+            if (idx > 80) idx -= 80;
+        }
+    }
+}

@@ -173,4 +173,48 @@
     dct4_apply(&mdct->dct, tmp, output);
 }
 
+
+/* The encoder profile supplies 480 current samples, 360 history samples and
+ * 120 trailing zero samples. Fold directly into the DCT input instead of
+ * materializing, windowing and recopying a 960-sample concatenation.
+ * Each product must round before the following add/subtract, as it does in
+ * the reference mult_vec() pass. Do not contract these into fused operations.
+ */
+#if defined(__GNUC__) && !defined(__clang__)
+__attribute__((noinline, noclone, optimize("fp-contract=off", "no-partial-inlining")))
+#endif
+void mdct_apply(const LC3_FLOAT* input, LC3_FLOAT* output, Mdct* mdct)
+{
+#if defined(__clang__)
+#pragma clang fp contract(off)
+#endif
+    if (mdct->length != 480 || mdct->mem_length != 360 || mdct->leading_zeros != 120) {
+        mdct_apply_general(input, output, mdct);
+        return;
+    }
+    LC3_FLOAT folded[480];
+    const LC3_FLOAT *w = mdct->window;
+    const LC3_FLOAT *history = mdct->mem;
+    for (int i = 0; i < 120; ++i) {
+        LC3_FLOAT a = input[359 - i] * w[719 - i];
+        LC3_FLOAT b = input[360 + i] * w[720 + i];
+        folded[i] = -a - b;
+
+        a = input[239 - i] * w[599 - i];
+        b = 0.0f * w[840 + i];
+        folded[120 + i] = -a - b;
+
+        a = history[i] * w[i];
+        b = input[119 - i] * w[479 - i];
+        folded[240 + i] = a - b;
+
+        a = history[120 + i] * w[120 + i];
+        b = history[359 - i] * w[359 - i];
+        folded[360 + i] = a - b;
+    }
+    /* Update only after all history reads, preserving the same next state. */
+    move_float(mdct->mem, input + 120, 360);
+    dct4_apply(&mdct->dct, folded, output);
+}
+
 void processMdct_fl(LC3_FLOAT* in, LC3_FLOAT* out, Mdct* mdctStruct) { mdct_apply(in, out, mdctStruct); }

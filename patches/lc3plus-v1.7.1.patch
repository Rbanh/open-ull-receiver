diff -ruN a/floating_point/pow2_exact.h b/floating_point/pow2_exact.h
--- a/floating_point/pow2_exact.h	1969-12-31 19:00:00.000000000 -0500
+++ b/floating_point/pow2_exact.h	2026-09-16 16:29:41.969893697 -0400
@@ -0,0 +1,59 @@
+/* Base-2 specialization of newlib4.3.0 ef_pow.c, restricted to |y|<=32.
+ * Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
+ * Developed at SunPro, a Sun Microsystems, Inc. business.
+ * Permission to use, copy, modify, and distribute this software is freely
+ * granted, provided that this notice is preserved.
+ *
+ * Derived from Espressif newlib4.3.0, commit
+ * 1cc5829f04ef0bb1edc913e55ac7c47d58a46646, newlib/libm/math/ef_pow.c.
+ * Experimental: preserve the existing exponential polynomial/operation order.
+ * Use the project's normal powf for out-of-domain and nonfinite exponents.
+ */
+#ifndef ULL_POW2_EXACT_H
+#define ULL_POW2_EXACT_H
+
+#include <stdint.h>
+#include <math.h>
+static inline uint32_t ull_float_bits(float x){union{float f;uint32_t u;}v={.f=x};return v.u;}
+static inline float ull_float_from_bits(uint32_t u){union{float f;uint32_t u;}v={.u=u};return v.f;}
+#ifndef ULL_POW2_ATTR
+#define ULL_POW2_ATTR
+#endif
+static ULL_POW2_ATTR float ull_pow2_exact(float y)
+{
+    const float P1=1.6666667163e-01f, P2=-2.7777778450e-03f,
+        P3=6.6137559770e-05f, P4=-1.6533901999e-06f, P5=4.1381369442e-08f;
+    const float lg2=6.9314718246e-01f,lg2_h=6.93145752e-01f,lg2_l=1.42860654e-06f;
+    uint32_t iy=ull_float_bits(y)&0x7fffffffu;
+    if(iy>0x42000000u)return powf(2.0f,y);
+    if(iy==0)return 1.0f;
+    if(iy==0x3f800000u)return y<0?0.5f:2.0f;
+    if(ull_float_bits(y)==0x40000000u)return 4.0f;
+    if(ull_float_bits(y)==0x3f000000u)return 0x1.6a09e6p+0f;
+    /* For x=2, the general logarithm stage has exactly t1=1, t2=0.
+     * Keep the original y split and exponential reduction unchanged. */
+    float y1=ull_float_from_bits(ull_float_bits(y)&0xfffff000u);
+    float p_l=y-y1,p_h=y1,z=p_l+p_h,t,u,v,w,t1,r;
+    int32_t j=(int32_t)ull_float_bits(z),i=j&0x7fffffff,k=(i>>23)-0x7f,n=0;
+    if(i>0x3f000000){
+        n=j+(0x00800000>>(k+1));
+        k=((n&0x7fffffff)>>23)-0x7f;
+        t=ull_float_from_bits((uint32_t)n&~(0x007fffffu>>k));
+        n=((n&0x007fffff)|0x00800000)>>(23-k);
+        if(j<0)n=-n;
+        p_h-=t;
+    }
+    t=p_l+p_h;
+    t=ull_float_from_bits(ull_float_bits(t)&0xfffff000u);
+    u=t*lg2_h;
+    v=(p_l-(t-p_h))*lg2+t*lg2_l;
+    z=u+v;
+    w=v-(z-u);
+    t=z*z;
+    t1=z-t*(P1+t*(P2+t*(P3+t*(P4+t*P5))));
+    r=(z*t1)/(t1-2.0f)-(w+z*w);
+    z=1.0f-(r-z);
+    return ull_float_from_bits(ull_float_bits(z)+((uint32_t)n<<23));
+}
+
+#endif /* ULL_POW2_EXACT_H */
